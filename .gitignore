# Local build and IDE state
.gradle/
.kotlin/
.idea/
.local/
**/build/
local.properties
*.iml
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db

# Device captures and investigation output
artifacts/
.codex-remote-attachments/
.nocommit/
